# Local development secrets. Copy this file to `.dev.vars` and fill in values.
# `.dev.vars` is gitignored — never commit real secrets.

# Password for the /admin login.
ADMIN_PASSWORD=change-me

# Long random string used to sign the admin session cookie.
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string

# GitHub token + repo used to trigger audio generation on upload.
GITHUB_TOKEN=
GITHUB_REPO=Earthfill/linguaband

# Optional public base URL for audio stored in R2 (e.g. https://audio.example.com).
# Leave empty to keep serving audio from bundled files.
AUDIO_BASE_URL=
