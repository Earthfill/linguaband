# Local development secrets. Copy this file to `.dev.vars` and fill in values.
# `.dev.vars` is gitignored — never commit real secrets.

# Password for the /admin login.
ADMIN_PASSWORD=change-me

# Long random string used to sign the admin session cookie.
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string

# GitHub token + repo used to trigger audio generation on upload.
GITHUB_TOKEN=
GITHUB_REPO=Earthfill/linguaband

# Public base URL for audio stored in R2 (e.g. https://audio.linguaband.com).
# Leave empty to serve only the bundled audio (mock-01 fallback + practice tracks).
AUDIO_BASE_URL=https://audio.linguaband.com

# Gemini API key for AI-assisted writing feedback (server-side only).
GEMINI_API_KEY=
# Optional model override. Default: gemini-2.5-flash-lite.
# Use gemini-3.5-flash-lite if your API key/account cannot access Gemini 2.5 models.
GEMINI_MODEL=gemini-2.5-flash-lite

# Google OAuth for learner sign-in to AI writing feedback.
# Add https://<your-domain>/api/auth/google/callback as an authorized redirect URI
# in the Google OAuth client. Locally, use the exact Wrangler dev URL/port.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# Generate a long random secret (at least 32 characters).
LEARNER_SESSION_SECRET=

# Resend email delivery for signup verification and first-Google-login welcome email.
# Use a sender address verified in Resend, e.g. Linguaband <hello@example.com>.
RESEND_API_KEY=
RESEND_FROM=
# Public origin used in email links; use your production HTTPS origin in production.
APP_BASE_URL=http://localhost:3000
